{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:garganta_scream_white",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/garganta_scream_white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.7
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.wl_dx*20*variable.particle_age",
          "variable.wl_dy*20*variable.particle_age",
          "variable.wl_dz*20*variable.particle_age"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.25+variable.particle_age",
          "0.25+variable.particle_age"
        ],
        "facing_camera_mode": "direction_z",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        },
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.wl_dx",
            "variable.wl_dy",
            "variable.wl_dz"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.75*(1-variable.particle_age/0.7)"
        ]
      }
    }
  }
}
