      "materials": {
        "default": "entity_alphatest",
        "gills": "entity_emissive"
      },
      "textures": {
        "default": "textures/entity/garganta_abierta",
        "gills": "textures/entity/garganta_gills"
      },
      "geometry": {
        "default": "geometry.warland.garganta_abierta",
        "gills": "geometry.warland.garganta_abierta.gills"
      },
      "animations": {
        "idle": "animation.warland.garganta_abierta.idle",
        "walk": "animation.warland.garganta_abierta.walk",
        "run": "animation.warland.garganta_abierta.run",
        "search": "animation.warland.garganta_abierta.search",
        "listen_echo": "animation.warland.garganta_abierta.listen_echo",
        "listen_echo_2": "animation.warland.garganta_abierta.listen_echo_2",
        "listen_echo_3": "animation.warland.garganta_abierta.listen_echo_3",
        "shake": "animation.warland.garganta_abierta.shake",
        "mouth_open": "animation.warland.garganta_abierta.mouth_open",
        "mouth_close": "animation.warland.garganta_abierta.mouth_close",
        "alarm": "animation.warland.garganta_abierta.alarm",
        "attack_bite": "animation.warland.garganta_abierta.attack_bite",
        "attack_lunge": "animation.warland.garganta_abierta.attack_lunge",
        "hurt": "animation.warland.garganta_abierta.hurt",
        "death": "animation.warland.garganta_abierta.death",
        "motion": "controller.animation.warland.garganta.motion"
      },
      "scripts": {
        "animate": [
          "motion"
        ],
        "initialize": [
          "variable.garganta_echo = 0;",
          "variable.garganta_detected = 0;"
        ],
        "pre_animation": [
          "variable.garganta_detected = query.property('warland:detected') && query.property('warland:phase') == 1;"
        ]
      },
      "render_controllers": [
        {
          "controller.render.warland.garganta_abierta": "query.is_alive"
        },
        {
          "controller.render.warland.garganta_abierta.gills": "query.is_alive"
        }
      ],
      "sound_effects": {
        "echo": "warland.garganta.echo",
        "echo_01": "warland.garganta.echo_01",
        "echo_02": "warland.garganta.echo_02",
        "echo_03": "warland.garganta.echo_03",
        "alarm": "warland.garganta.alarm"
      },
      "spawn_egg": {
        "base_color": "#26221e",
        "overlay_color": "#c2b19a"
      },
      "particle_effects": {
        "scream_wave": "warland:garganta_scream_white"
      }
    }
  }
}
