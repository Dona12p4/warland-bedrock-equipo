{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland_biomes:soul_storm_dust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/warland/biomes_particles/particle/biomes/desert/sand_air"
      }
    },
    "curves": {
      "variable.opacity": {
        "type": "catmull_rom",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [
          0,
          0,
          0.85,
          0.86,
          0.58,
          0.7,
          0,
          0
        ]
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "math.clamp((math.random(3, 7)), 0, 12)",
        "max_particles": 24
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          -12,
          3,
          -5
        ],
        "half_dimensions": [
          12,
          8,
          12
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.clamp((math.random(2.7, 3.1)), 0.1, 8)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "-math.random(80, 100)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "4 * (0.8 + v.particle_random_1) * 5",
          "math.random(-2, 2) + Math.sin(v.particle_age * 90) * 10 + 25*(v.particle_random_2-0.5)",
          "1.3 * (0.8 + v.particle_random_1) * 5"
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          4,
          4
        ],
        "facing_camera_mode": "lookat_xyz"
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.4 + v.emitter_random_1 * 0.6",
          1,
          1,
          "(0.2 + v.particle_random_3 * 0.5) * variable.opacity"
        ]
      }
    }
  }
}
