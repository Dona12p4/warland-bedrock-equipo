{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland_biomes:underwater_bubbles",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/warland/biomes_particles/particle/biomes/underwater/underwater_bubbles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "math.clamp((math.random(2, 30)), 0, 12)",
        "max_particles": 24
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_disc": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 25,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.clamp((math.random(4, 10)), 0.1, 8)"
      },
      "minecraft:particle_expire_if_not_in_blocks": [
        "minecraft:water"
      ],
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(-18, 18)",
        "rotation_rate": "math.random(-15, 14)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "(0.5-v.emitter_random_1) * 5",
          "1 + v.particle_random_4",
          "(0.5-v.emitter_random_2) * 5"
        ],
        "linear_drag_coefficient": 9,
        "rotation_drag_coefficient": 0.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + v.particle_random_4 * 0.05",
          "0.1 + v.particle_random_4 * 0.05"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 2,
          "texture_height": 2,
          "uv": [
            "math.floor(v.particle_random_3*2)",
            "math.floor(v.particle_random_4*2)"
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
