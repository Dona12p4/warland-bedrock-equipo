{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.warland.pasado.scene": {
      "initial_state": "waiting",
      "states": {
        "waiting": {
          "animations": [
            "idle",
            "orb_hidden"
          ],
          "transitions": [
            {
              "acting": "query.property('warland:performance')"
            }
          ]
        },
        "acting": {
          "animations": [
            "performance"
          ],
          "transitions": [
            {
              "waiting": "!query.property('warland:performance')"
            }
          ]
        }
      }
    }
  }
}
