{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:past_departure",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/past_halo"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 240
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 3.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(.09 + variable.particle_random_2 * .18) * (1 + variable.particle_age * .5)",
          "(.09 + variable.particle_random_2 * .18) * (1 + variable.particle_age * .5)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.56,
          0.28,
          0.74,
          "0.55 * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          1.6,
          3.2,
          0.9
        ],
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "0.3 + variable.particle_random_1 * 0.8",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.12,
          0
        ],
        "linear_drag_coefficient": 0.8
      }
    }
  }
}
