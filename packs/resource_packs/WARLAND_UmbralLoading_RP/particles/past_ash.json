{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:past_ash",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/past_ash"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 72
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2.8
      },
      "minecraft:particle_initial_speed": [
        "2.7 + variable.particle_random_1 * 1.4",
        -0.35,
        0.8
      ],
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0.24,
          -0.04,
          0.08
        ]
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 1,
        "coefficient_of_restitution": 0,
        "collision_radius": 0.02,
        "expire_on_contact": true
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1 * 360",
        "rotation_rate": "-40 + variable.particle_random_3 * 80"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.042 + variable.particle_random_2 * 0.038",
          "0.042 + variable.particle_random_2 * 0.038"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.73,
          0.72,
          0.69,
          "0.95 * math.min(1, variable.particle_age / 0.2) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.5)"
        ]
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          -3,
          1,
          -1
        ],
        "half_dimensions": [
          6,
          3.2,
          6
        ],
        "direction": [
          0,
          -1,
          0
        ]
      }
    }
  }
}
