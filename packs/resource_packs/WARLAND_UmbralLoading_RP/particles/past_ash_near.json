{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:past_ash_near",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/past_ash"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 20
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.65
      },
      "minecraft:particle_initial_speed": [
        "5.5 + variable.particle_random_1 * 2.5",
        "-6.5 - variable.particle_random_3 * 3",
        1.8
      ],
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0.6,
          -1,
          0.1
        ]
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 1,
        "coefficient_of_restitution": 0,
        "collision_radius": 0.02,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.016 + variable.particle_random_2 * 0.012",
          "0.10 + variable.particle_random_2 * 0.18"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.73,
          0.72,
          0.69,
          "0.86 * math.min(1, variable.particle_age / 0.08) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.20)"
        ]
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          -3,
          2,
          -1
        ],
        "half_dimensions": [
          2.8,
          2,
          2.8
        ],
        "direction": [
          0,
          -1,
          0
        ]
      }
    }
  }
}
