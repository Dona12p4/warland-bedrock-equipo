        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.73,
          0.72,
          0.69,
          "0.82 * math.min(1, variable.particle_age / 0.4) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.8)"
        ]
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          1,
          0
        ],
        "half_dimensions": [
          3.8,
          2.5,
          3.8
        ],
        "direction": [
          0,
          -1,
          0
        ]
      }
    }
