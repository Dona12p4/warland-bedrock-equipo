{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:past_guide_sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/past_white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2
      },
      "minecraft:particle_initial_speed": [
        0,
        1.1,
        0
      ],
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.1,
          0
        ]
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 1,
        "coefficient_of_restitution": 0,
        "collision_radius": 0.02,
        "expire_on_contact": true
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1 * 360",
        "rotation_rate": "-40 + variable.particle_random_3 * 80"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.045,
          0.045
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.min(1, variable.particle_age / 0.2) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.4)"
        ]
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          1.2,
          0.15,
          1.2
        ],
        "direction": [
          0,
          -1,
          0
        ]
      }
    }
  }
}
