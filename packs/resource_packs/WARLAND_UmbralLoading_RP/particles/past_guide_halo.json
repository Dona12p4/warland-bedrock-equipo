{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:past_guide_halo",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/past_white"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          1.8,
          17
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.5 * math.min(1, variable.particle_age / 0.1) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.1)"
        ]
      }
    }
  }
}
