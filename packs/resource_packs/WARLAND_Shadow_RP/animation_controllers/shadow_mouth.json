{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.warland.shadow_boss.mouth": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "cry": "query.property('warland:aggressive')"
            }
          ]
        },
        "cry": {
          "animations": [
            "scream_mouth"
          ],
          "transitions": [
            {
              "held": "query.all_animations_finished"
            }
          ]
        },
        "held": {
          "transitions": [
            {
              "idle": "!query.property('warland:aggressive')"
            }
          ]
        }
      }
    }
  }
}
