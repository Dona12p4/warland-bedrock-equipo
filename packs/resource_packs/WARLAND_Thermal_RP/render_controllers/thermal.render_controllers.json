{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.warland.thermal": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.warland.thermal_veins": {
      "geometry": "Geometry.veins",
      "materials": [
        {
          "*": "Material.veins"
        }
      ],
      "textures": [
        "Texture.veins"
      ],
      "color": {
        "r": "query.property('warland:thermal_signal') * 0.01",
        "g": "query.property('warland:thermal_signal') * 0.01",
        "b": "query.property('warland:thermal_signal') * 0.01",
        "a": 1
      }
    }
  }
}
