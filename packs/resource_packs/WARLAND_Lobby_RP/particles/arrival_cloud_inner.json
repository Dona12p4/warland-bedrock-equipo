{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:arrival_cloud_inner",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arrival_cloud"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5.2
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(4.5+variable.particle_random_1*4)*math.cos(variable.particle_random_1*540+variable.particle_age*52)",
          "variable.arrival_cloud_y-.6+(variable.particle_random_3-.5)",
          "(4.5+variable.particle_random_1*4)*math.sin(variable.particle_random_1*540+variable.particle_age*52)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "2+variable.particle_random_2",
          1.2
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.48,
          0.54,
          0.65,
          ".9*math.clamp(variable.particle_age/.55,0,1)*math.clamp((5.2-variable.particle_age)/1.3,0,1)"
        ]
      }
    }
  }
}
