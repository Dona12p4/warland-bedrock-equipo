{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:arrival_vortex_sparks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lobby_light"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 32
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5.2
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(3+variable.particle_random_1*10)*(1-.12*variable.particle_age)*math.cos(variable.particle_random_1*720+variable.particle_age*65)",
          "variable.arrival_cloud_y+.4+(variable.particle_random_3-.5)",
          "(3+variable.particle_random_1*10)*(1-.12*variable.particle_age)*math.sin(variable.particle_random_1*720+variable.particle_age*65)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.13,
          0.38
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          ".9*math.clamp(variable.particle_age/.5,0,1)*math.clamp((5.2-variable.particle_age)/1.3,0,1)"
        ]
      }
    }
  }
}
