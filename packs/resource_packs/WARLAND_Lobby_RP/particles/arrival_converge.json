{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:arrival_converge",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lobby_light"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 28
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.55
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(2.1*(1-(math.clamp(variable.particle_age/1.4,0,1)*math.clamp(variable.particle_age/1.4,0,1)*(3-2*math.clamp(variable.particle_age/1.4,0,1)))))*math.cos(variable.particle_random_1*360+variable.particle_age*150)",
          ".15+variable.particle_random_2*2.1",
          "(2.1*(1-(math.clamp(variable.particle_age/1.4,0,1)*math.clamp(variable.particle_age/1.4,0,1)*(3-2*math.clamp(variable.particle_age/1.4,0,1)))))*math.sin(variable.particle_random_1*360+variable.particle_age*150)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.11,
          0.18
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp(variable.particle_age/.15,0,1)*math.clamp((1.55-variable.particle_age)/.35,0,1)"
        ]
      }
    }
  }
}
