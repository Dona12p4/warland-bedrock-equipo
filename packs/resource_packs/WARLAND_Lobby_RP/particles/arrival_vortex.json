{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:arrival_vortex",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/arrival_vortex"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5.4
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          0,
          "variable.arrival_cloud_y+(variable.particle_random_3-.5)*.6",
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "14-variable.particle_age*.3",
          "14-variable.particle_age*.3"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          ".8*math.clamp(variable.particle_age/.5,0,1)*math.clamp((5.4-variable.particle_age)/1.7,0,1)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_1*180",
        "rotation_rate": 34
      }
    }
  }
}
