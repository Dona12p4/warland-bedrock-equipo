{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:arrival_embers",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/lobby_light"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.25
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "(variable.particle_random_1-.5)*(1+variable.particle_age)",
          ".2+variable.particle_random_2*1.8+variable.particle_age*.6",
          "(variable.particle_random_3-.5)*(1+variable.particle_age)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.06,
          0.09
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          ".7*math.clamp((1.25-variable.particle_age)/.7,0,1)"
        ]
      }
    }
  }
}
