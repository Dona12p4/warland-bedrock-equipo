{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "warland:umbral_relief",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/umbral_relief"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.8
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.wl_size",
          "variable.wl_size"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "variable.wl_alpha * math.min(1, variable.particle_age / 0.08) * math.min(1, (variable.particle_lifetime - variable.particle_age) / 0.2)"
        ]
      }
    }
  }
}
