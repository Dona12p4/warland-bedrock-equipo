{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.warland.claw_machine": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": [
						"move_x_z",
						"lever_move"
					],
					"transitions": [
						{
							"button": "query.property('warland:state') == 5"
						},
						{
							"drop": "query.property('warland:state') == 1"
						},
						{
							"win": "query.property('warland:state') == 2"
						},
						{
							"return": "query.property('warland:state') == 4"
						}
					]
				},
				"button": {
					"animations": ["lever_press"],
					"transitions": [
						{"drop": "query.property('warland:state') == 1"},
						{"idle": "query.property('warland:state') == 0"}
					]
				},
				"drop": {
					"animations": [
						"claw_drop"
					],
					"transitions": [
						{
							"grab": "query.property('warland:state') == 3"
						},
						{
							"idle": "query.property('warland:state') == 0"
						}
					]
				},
				"grab": {
					"animations": [
						"claw_grab"
					],
					"transitions": [
						{
							"win": "query.property('warland:state') == 2"
						},
						{
							"return": "query.property('warland:state') == 4"
						},
						{
							"idle": "query.property('warland:state') == 0"
						}
					]
				},
				"win": {
					"animations": [
						"win_drop"
					],
					"transitions": [
						{
							"idle": "query.property('warland:state') == 0"
						}
					]
				},
				"return": {
					"animations": [
						"claw_return"
					],
					"transitions": [
						{
							"idle": "query.property('warland:state') == 0"
						}
					]
				}
			}
		}
	}
}
